#Create vectors
Name <- c("Jeb", "Donald", "Ted", "Marco", "Carly", "Hillary", "Bernie")
ABC_poll   <- c(  4,62,51,21,2,14,15)
CBS_poll   <- c( 12,75,43,19,1,21,19)
#Combine into a data frame
df_polls <- data.frame(Name, ABC_poll, CBS_poll)
# Inspect your data frame
str(df_polls)
head(df_polls)
#Compute Summary Statistics
mean(df_polls$ABC_poll)
median(df_polls$CBS_poll)
range(df_polls[, c("ABC_poll","CBS_poll")])
#Add a column for the difference between CBS and ABC
df_polls$Diff <- df_polls$CBS_poll - df_polls$ABC_pol
#CBS_poll
ggplot(df_polls, aes(x=CBS_poll, y=Name))+
  geom_bar(stat = "identity", color="Purple")+
  coord_flip()
#ABC_poll
ggplot(df_polls, aes(x=ABC_poll, y=Name))+
  geom_bar(stat = "identity", color="blue")+
  coord_flip()
#Difference between polls
ggplot(df_polls, aes(x=Diff, y=Name, Title="ABC_Poll Data"))+
  geom_bar(stat = "identity", color="Pink")+
  coord_flip()
